# ── Telegram Bot ──────────────────────────────────────────────
BOT_TOKEN=your-telegram-bot-token-from-botfather
GROUP_CHAT_ID=-100000000000
ADMIN_TELEGRAM_ID=123456789

# ── База данных ────────────────────────────────────────────────
POSRES_DSN=postgres://user:password@localhost:5432/efootball?sslmode=disable

# ── Web API ────────────────────────────────────────────────────
PORT=8080
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FRONTEND_URL=https://your-domain.com

# ── Среда ──────────────────────────────────────────────────────
# Установите "production" для боевого сервера (убирает localhost из CORS)
APP_ENV=production

# ── Администратор (создаётся автоматически при первом запуске) ─
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploy
