# Dev only — in production the frontend is served by Go on the same origin,
# leave NEXT_PUBLIC_API_URL unset so the build uses relative paths.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google OAuth (same client ID as the backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Shows a "dev" login tab that lets you log in as any seeded user.
# Backend also gates this (APP_ENV != production) — never set in production.
NEXT_PUBLIC_DEV_LOGIN=true
